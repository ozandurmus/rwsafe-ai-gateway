# Runtime and local state never enter the repository (AGENTS.md 4, 14).
.local/
*.log
*.masked.txt
*.hprof
*.pcap
*.pcapng
*.har
*.db
*.sqlite
*.pem
*.key
*.p12
*.jks
.env
.env.*
!.env.example
known_hosts
.DS_Store
.idea/
.vscode/
node_modules/
build/
.gradle/
__pycache__/
.pytest_cache/
.rwsafe/
.githooks/

# Claude Code session state; the project settings file .claude/settings.json is committed.
.claude/scheduled_tasks.lock
.claude/*.local.json
.claude/worktrees/

# Jazzer fuzzing-mode working corpus (the committed regression corpus lives in src/test/resources).
.cifuzz-corpus/

# Frontend build output (the image build produces it; never committed).
frontend/dist/

# Local trial runtime state: logs, PID files, spool, snapshot cache (tools/trial/README.md).
tools/trial/.run/

# Build-time CA anchors copied into the image build context by the pilot runbook; never committed.
deploy/images/ca/*
!deploy/images/ca/.gitkeep
# The pinned Gradle distribution placed in the build context when the build host cannot download it (pilot step 4).
deploy/images/gradle-dist/*
!deploy/images/gradle-dist/.gitkeep
